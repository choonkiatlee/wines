{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "packages/vivino-client/src/**/*.ts",
    "packages/sainsburys-client/src/**/*.ts",
    "packages/retailer-ingestion/src/**/*.ts",
    "apps/pages/src/**/*.ts",
    "test/**/*.ts"
  ]
}
